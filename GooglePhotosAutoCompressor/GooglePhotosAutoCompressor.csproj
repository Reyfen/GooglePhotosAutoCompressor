<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- The app (GooglePhotosAutoCompressor.App) is the exe and takes the name GooglePhotosAutoCompressor. -->
    <AssemblyName>GooglePhotosAutoCompressor.Core</AssemblyName>
    <RootNamespace>GooglePhotosAutoCompressor</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="tools\ffmpeg.exe" />
  </ItemGroup>

  <!-- Bundled Windows ffmpeg. On Linux the app uses ffmpeg from PATH or offers to download it. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GooglePhotosAutoCompressor.Tests" />
    <InternalsVisibleTo Include="GooglePhotosAutoCompressor" />
    <InternalsVisibleTo Include="GooglePhotosAutoCompressor.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.58.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
