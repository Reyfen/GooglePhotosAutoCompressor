<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GooglePhotosAutoCompressor.App.ViewModels"
        x:Class="GooglePhotosAutoCompressor.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Google Photos Auto Compressor"
        Icon="avares://GooglePhotosAutoCompressor/Assets/icon.ico"
        Width="1040" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}">

  <DockPanel>
    <!-- Header -->
    <Border DockPanel.Dock="Top" Padding="20,14" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Image Source="avares://GooglePhotosAutoCompressor/Assets/icon.png" Width="40" Height="40" />
        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
          <TextBlock Text="Google Photos Auto Compressor" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Classes="muted" FontSize="12"
                     Text="Replaces your biggest videos and photos in Google Photos with smaller copies." />
        </StackPanel>
        <Button Grid.Column="2" Classes="big" Classes.primary="{Binding IsIdle}" Classes.danger="{Binding IsRunning}"
                Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                IsEnabled="{Binding !IsStopping}" MinWidth="130" HorizontalContentAlignment="Center"
                ToolTip.Tip="Start a run, or stop at the next safe point" />
      </Grid>
    </Border>

    <TabControl Margin="12,4,12,8" Padding="0,8,0,0">

      <!-- RUN -->
      <TabItem Header="Run">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="4,0,4,8">

            <!-- Status and progress -->
            <Border Classes="card">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                             Classes.warn="{Binding StatusIsWarning}" Classes.error="{Binding StatusIsError}">
                    <TextBlock.Styles>
                      <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="{DynamicResource WarnAmber}" /></Style>
                      <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="{DynamicResource ErrorRed}" /></Style>
                    </TextBlock.Styles>
                  </TextBlock>
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding ElapsedText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>

                <ProgressBar Value="{Binding OverallProgress}" IsIndeterminate="{Binding OverallIndeterminate}"
                             IsVisible="{Binding IsRunning}" Height="8" CornerRadius="4" />

                <StackPanel IsVisible="{Binding ShowCurrentItem}" Spacing="4">
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding CurrentItemText}" TextTrimming="CharacterEllipsis" />
                  <ProgressBar Value="{Binding CurrentItemProgress}" Height="4" ShowProgressText="False" />
                </StackPanel>

                <!-- Steps -->
                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,6,0,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StepViewModel">
                      <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <Border Width="34" Height="34" CornerRadius="17" HorizontalAlignment="Center"
                                Background="{DynamicResource StepPendingBrush}"
                                Classes.active="{Binding IsActive}" Classes.done="{Binding IsDone}">
                          <Border.Styles>
                            <Style Selector="Border.active"><Setter Property="Background" Value="{DynamicResource AccentBlue}" /></Style>
                            <Style Selector="Border.done"><Setter Property="Background" Value="{DynamicResource DoneGreen}" /></Style>
                          </Border.Styles>
                          <TextBlock Text="{Binding Badge}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     FontWeight="SemiBold" Foreground="White" />
                        </Border>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12"
                                   Classes.muted="{Binding IsPending}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Stats -->
            <UniformGrid Columns="5" Rows="1">
              <UniformGrid.Styles>
                <Style Selector="UniformGrid > Border"><Setter Property="Margin" Value="0,0,8,0" /></Style>
              </UniformGrid.Styles>
              <Border Classes="card" ToolTip.Tip="Space freed in Google Photos so far (originals minus copies)">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Space saved" />
                  <TextBlock Classes="statValue" Foreground="{DynamicResource DoneGreen}" Text="{Binding SavedSpaceText}" /></StackPanel>
              </Border>
              <Border Classes="card" ToolTip.Tip="Copy uploaded and dated">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Done" />
                  <TextBlock Classes="statValue" Text="{Binding DoneCount}" /></StackPanel>
              </Border>
              <Border Classes="card" ToolTip.Tip="Started; the next runs finish them">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="In progress" />
                  <TextBlock Classes="statValue" Text="{Binding InProgressCount}" /></StackPanel>
              </Border>
              <Border Classes="card" ToolTip.Tip="Big enough, not started yet">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Waiting" />
                  <TextBlock Classes="statValue" Text="{Binding WaitingCount}" /></StackPanel>
              </Border>
              <Border Classes="card" Margin="0" ToolTip.Tip="Left alone: already small, would not save space, or failed">
                <StackPanel><TextBlock Classes="muted" FontSize="12" Text="Left alone / failed" />
                  <TextBlock Classes="statValue">
                    <Run Text="{Binding LeftAloneCount}" /><Run Text=" / " /><Run Text="{Binding FailedCount}" Foreground="{DynamicResource ErrorRed}" />
                  </TextBlock></StackPanel>
              </Border>
            </UniformGrid>

            <!-- Log -->
            <Border Classes="card">
              <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                  <TextBlock Classes="h2" Text="Activity" Margin="0" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="Copy" Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy the activity log" />
                    <Button Content="Open log file" Command="{Binding OpenLogCommand}" ToolTip.Tip="{Binding LogPath}" />
                  </StackPanel>
                </Grid>
                <Border Background="{DynamicResource LogBrush}" CornerRadius="6" Height="260">
                  <Panel>
                  <StackPanel IsVisible="{Binding !LogLines.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4" Margin="20">
                    <TextBlock Classes="muted" HorizontalAlignment="Center" Text="What the app does appears here once you press Start." />
                    <TextBlock Classes="muted" HorizontalAlignment="Center" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                               Text="A Chrome window opens for Google Photos. Leave it open while the app works; you can keep using your PC." />
                  </StackPanel>
                  <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="Transparent"
                           FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,Menlo,monospace" FontSize="12">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8,1" /><Setter Property="MinHeight" Value="0" /></Style>
                    </ListBox.Styles>
                  </ListBox>
                  </Panel>
                </Border>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ITEMS -->
      <TabItem Header="Items">
        <DockPanel Margin="4,0,4,8">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}" MinWidth="180" />
            <TextBox Grid.Column="1" Margin="8,0" Watermark="Search by file name or date" Text="{Binding SearchText}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
              <Button Content="Try failed again" Command="{Binding RetryFailedCommand}" />
              <Button Content="Free up disk space" Command="{Binding FreeDiskSpaceCommand}"
                      ToolTip.Tip="Delete local files of finished items" />
            </StackPanel>
          </Grid>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="2,8,2,0">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ItemsSummary}" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="12" Text="{Binding CacheSizeText}" />
          </Grid>
          <Border Classes="card" Padding="0">
            <DockPanel>
              <Grid DockPanel.Dock="Top" ColumnDefinitions="110,110,*,90,90,60,210" Margin="14,10,14,6">
                <Grid.Styles><Style Selector="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="12" /></Style></Grid.Styles>
                <TextBlock Text="Date" /><TextBlock Grid.Column="1" Text="Type" /><TextBlock Grid.Column="2" Text="File" />
                <TextBlock Grid.Column="3" Text="Original" /><TextBlock Grid.Column="4" Text="Copy" />
                <TextBlock Grid.Column="5" Text="Saved" /><TextBlock Grid.Column="6" Text="Status" />
              </Grid>
              <ListBox ItemsSource="{Binding Items}" Background="Transparent">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="14,6" /></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ItemRow">
                    <Grid ColumnDefinitions="110,110,*,90,90,60,210">
                      <TextBlock Text="{Binding Date}" />
                      <TextBlock Grid.Column="1" Text="{Binding Kind}" Classes="muted" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                      <TextBlock Grid.Column="3" Text="{Binding Size}" />
                      <TextBlock Grid.Column="4" Text="{Binding CopySize}" />
                      <TextBlock Grid.Column="5" Text="{Binding Saved}" Foreground="{DynamicResource DoneGreen}" />
                      <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </DockPanel>
      </TabItem>

      <!-- SETTINGS -->
      <TabItem Header="Settings">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="4,0,4,12" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel"
                      MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel.Styles>
              <Style Selector="NumericUpDown"><Setter Property="Width" Value="150" /><Setter Property="HorizontalAlignment" Value="Left" /></Style>
              <Style Selector="Grid.row"><Setter Property="Margin" Value="0,6" /></Style>
            </StackPanel.Styles>

            <TextBlock Classes="hint" Margin="2,0" Text="Changes are saved straight away and used from the next run. They are locked while a run is going."
                       IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsIdle}" />
            <TextBlock Classes="hint" Margin="2,0" Foreground="{DynamicResource WarnAmber}" Text="A run is going: settings are locked until it ends."
                       IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsRunning}" />

            <StackPanel Spacing="12" IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsIdle}">

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="h2" Text="What to compress" />
                  <Grid Classes="row" ColumnDefinitions="260,*" RowDefinitions="Auto,Auto">
                    <CheckBox Content="Videos" IsChecked="{Binding CompressVideos}" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MinVideoMbPerSecond}" Minimum="0" Maximum="100" Increment="0.1" FormatString="0.0" IsEnabled="{Binding CompressVideos}" />
                      <TextBlock Classes="hint" Text="Only videos above this many MB per second of video. Phone videos are usually 2–6 MB/s; 0.8 skips ones that are already small." />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <CheckBox Content="Photos (JPEG)" IsChecked="{Binding CompressPhotos}" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MinPhotoMb}" Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.0" IsEnabled="{Binding CompressPhotos}" />
                      <TextBlock Classes="hint" Text="Only photos bigger than this many MB. HEIC, PNG and photos without a date taken are always left alone." />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="h2" Text="Quality" />
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Video size" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding VideoResolutionOptions}" SelectedIndex="{Binding VideoResolutionIndex}" MinWidth="320" />
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Video quality" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <Slider Minimum="16" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding VideoCrf}" MaxWidth="360" HorizontalAlignment="Left" Width="360" />
                      <TextBlock Classes="hint" Text="{Binding VideoQualityText}" />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Photo size (megapixels)" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MaxPhotoMegapixels}" Minimum="1" Maximum="200" Increment="1" FormatString="0" />
                      <TextBlock Classes="hint" Text="Bigger photos are shrunk to this. 16 MP is what Google's own &quot;Storage saver&quot; keeps." />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Photo quality" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <Slider Minimum="60" Maximum="98" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PhotoJpegQuality}" Width="360" HorizontalAlignment="Left" />
                      <TextBlock Classes="hint" Text="{Binding PhotoQualityText}" />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Smallest saving worth it (%)" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MinSavingPercent}" Minimum="1" Maximum="90" Increment="5" FormatString="0" />
                      <TextBlock Classes="hint" Text="If a copy is not at least this much smaller, the original is kept." />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="h2" Text="How much per run" />
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Items per batch" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding ItemsPerBatch}" Minimum="1" Maximum="1000" Increment="5" FormatString="0" />
                      <TextBlock Classes="hint" Text="How many items are worked on at once. Each needs disk space for the original and its copy." />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Keep going" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <CheckBox Content="Start the next batch automatically until nothing is left" IsChecked="{Binding RepeatUntilDone}" />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Downloads at the same time" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Column="1" Value="{Binding ParallelDownloads}" Minimum="1" Maximum="10" Increment="1" FormatString="0" />
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Keep free on disk (GB)" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MinFreeDiskGb}" Minimum="0" Maximum="10000" Increment="1" FormatString="0.#" />
                      <TextBlock Classes="hint" Text="Downloads pause for this run when the disk would get fuller than this." />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Attempts before giving up on an item" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <NumericUpDown Value="{Binding MaxFails}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
                      <TextBlock Classes="hint" Text="Attempts lost while the internet is down do not count." />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Classes="h2" Text="Safety and files" />
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Before moving to the bin" VerticalAlignment="Center" />
                    <CheckBox Grid.Column="1" Content="Show what will be moved and ask first" IsChecked="{Binding ConfirmBeforeBin}" />
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="When an item is done" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <CheckBox Content="Delete its files from this PC" IsChecked="{Binding DeleteLocalFilesWhenDone}" />
                      <TextBlock Classes="hint" Text="Off: the downloaded originals stay on this PC as an extra backup (use &quot;Free up disk space&quot; on the Items page later)." />
                    </StackPanel>
                  </Grid>
                  <Grid Classes="row" ColumnDefinitions="260,*">
                    <TextBlock Text="Work folder" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding WorkFolder}" Watermark="Downloads folder" />
                        <Button Grid.Column="1" Margin="6,0,0,0" Content="Browse…" Command="{Binding BrowseWorkFolderCommand}" />
                      </Grid>
                      <TextBlock Classes="hint" Text="{Binding WorkFolderHint}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="Auto,*">
                <Button Content="Reset to defaults" Command="{Binding ResetToDefaultsCommand}" />
                <TextBlock Grid.Column="1" Classes="muted" Margin="12,0" VerticalAlignment="Center" Text="{Binding SavedText}" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- HELP -->
      <TabItem Header="Help">
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="4,0,4,12" MaxWidth="820" HorizontalAlignment="Left">
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="How it works" />
                <TextBlock TextWrapping="Wrap" Text="1. Sign in to Google in the Chrome window the app opens (only the first time)." />
                <TextBlock TextWrapping="Wrap" Text="2. It downloads the biggest items from &quot;Large photos and videos&quot; and makes smaller copies on this PC." />
                <TextBlock TextWrapping="Wrap" Text="3. Each copy is checked. If it looks wrong or saves too little, the original is kept." />
                <TextBlock TextWrapping="Wrap" Text="4. Originals go to the Google Photos bin (kept 60 days), then the copies are uploaded and given the original date." />
                <TextBlock TextWrapping="Wrap" Text="Leave the Chrome window open while it works. You can press Stop, close the app or lose the internet at any time: the next run carries on where it stopped." />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Good to know" />
                <TextBlock TextWrapping="Wrap" Text="• Compression lowers quality a little. Once the bin is emptied, the originals are gone for good." />
                <TextBlock TextWrapping="Wrap" Text="• The app clicks through the Google Photos website. If Google changes it, a step can stop working; the copies and originals stay safe because each step checks before it acts." />
                <TextBlock TextWrapping="Wrap" Text="• Automating the website may be against Google's terms. Use it on your own account at your own risk." />
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="8">
                <TextBlock Classes="h2" Text="Shortcuts" />
                <WrapPanel>
                  <WrapPanel.Styles><Style Selector="Button"><Setter Property="Margin" Value="0,0,8,8" /></Style></WrapPanel.Styles>
                  <Button Content="Google Photos bin" Command="{Binding OpenBinCommand}" />
                  <Button Content="Large photos and videos" Command="{Binding OpenLargeFilesCommand}" />
                  <Button Content="Work folder" Command="{Binding OpenWorkFolderCommand}" />
                  <Button Content="Log file" Command="{Binding OpenLogCommand}" />
                  <Button Content="Project page" Command="{Binding OpenProjectPageCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
